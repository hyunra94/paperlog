const NOTION_VERSION = "2022-06-28";

export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: corsHeaders(request, env),
      });
    }

    try {
      const clientKey = request.headers.get("x-paper-log-key");

      if (!env.SECRET_KEY || clientKey !== env.SECRET_KEY) {
        return json(request, env, { error: "Unauthorized" }, 401);
      }

      if (url.pathname === "/api/test" && request.method === "GET") {
        return json(request, env, {
          ok: true,
          message: "Paper Log Worker connected",
          hasTodoDb: Boolean(env.NOTION_TODO_DB_ID),
          hasScheduleDb: Boolean(env.NOTION_SCHEDULE_DB_ID),
        });
      }

      if (url.pathname === "/api/calendar" && request.method === "GET") {
        return getCalendar(request, env);
      }

      if (url.pathname === "/api/todo" && request.method === "GET") {
        return getTodos(request, env);
      }

      if (url.pathname === "/api/todo" && request.method === "POST") {
        return createTodo(request, env);
      }

      if (url.pathname === "/api/schedule" && request.method === "GET") {
        return getSchedules(request, env);
      }

      if (url.pathname === "/api/schedule" && request.method === "POST") {
        return createSchedule(request, env);
      }

      return json(request, env, { error: "Not found" }, 404);
    } catch (error) {
      return json(
        request,
        env,
        {
          error: "Worker Error",
          message: error.message,
          status: error.status || 500,
          detail: error.detail || null,
        },
        error.status || 500
      );
    }
  },
};

/* =========================
   CORS / JSON
========================= */

function corsHeaders(request, env) {
  const requestOrigin = request.headers.get("Origin") || "";
  const allowedOrigins = String(env.CORS_ORIGIN || "*")
    .split(",")
    .map(v => v.trim())
    .filter(Boolean);

  let allowOrigin = "*";

  if (allowedOrigins.length && allowedOrigins[0] !== "*") {
    allowOrigin = allowedOrigins.includes(requestOrigin)
      ? requestOrigin
      : allowedOrigins[0];
  }

  return {
    "Access-Control-Allow-Origin": allowOrigin,
    "Access-Control-Allow-Methods": "GET,POST,PATCH,DELETE,OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type,x-paper-log-key",
    "Access-Control-Max-Age": "86400",
    "Vary": "Origin",
  };
}

function json(request, env, data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      "Content-Type": "application/json; charset=utf-8",
      ...corsHeaders(request, env),
    },
  });
}

/* =========================
   Notion 공통 함수
========================= */

async function notionFetch(env, path, options = {}) {
  const res = await fetch(`https://api.notion.com/v1${path}`, {
    ...options,
    headers: {
      "Authorization": `Bearer ${env.NOTION_TOKEN}`,
      "Notion-Version": NOTION_VERSION,
      "Content-Type": "application/json",
      ...(options.headers || {}),
    },
  });

  const text = await res.text();
  let data = null;

  try {
    data = text ? JSON.parse(text) : null;
  } catch {
    data = text;
  }

  if (!res.ok) {
    const error = new Error(`Notion API Error: ${res.status}`);
    error.status = res.status;
    error.detail = data;
    throw error;
  }

  return data;
}

async function notionQueryDatabase(env, databaseId, body = {}) {
  if (!databaseId) {
    const error = new Error("Database ID is missing");
    error.status = 500;
    throw error;
  }

  return notionFetch(env, `/databases/${databaseId}/query`, {
    method: "POST",
    body: JSON.stringify(body),
  });
}

async function notionRetrieveDatabase(env, databaseId) {
  if (!databaseId) {
    const error = new Error("Database ID is missing");
    error.status = 500;
    throw error;
  }

  return notionFetch(env, `/databases/${databaseId}`, {
    method: "GET",
  });
}

async function notionCreatePage(env, databaseId, properties) {
  return notionFetch(env, "/pages", {
    method: "POST",
    body: JSON.stringify({
      parent: {
        database_id: databaseId,
      },
      properties,
    }),
  });
}

/* =========================
   Notion 속성 읽기 함수
========================= */

function getTitleFromProperties(properties) {
  for (const prop of Object.values(properties || {})) {
    if (prop.type === "title") {
      return (prop.title || []).map(t => t.plain_text).join("").trim();
    }
  }
  return "";
}

function getRichText(properties, name) {
  const prop = properties?.[name];
  if (!prop) return "";

  const arr = prop.rich_text || [];
  return arr.map(t => t.plain_text).join("").trim();
}

function getCheckbox(properties, name) {
  return Boolean(properties?.[name]?.checkbox);
}

function getSelectName(properties, name) {
  return properties?.[name]?.select?.name || "";
}

function getMultiSelectNames(properties, name) {
  return (properties?.[name]?.multi_select || []).map(x => x.name);
}

function getRelationIds(properties, name) {
  return (properties?.[name]?.relation || []).map(x => x.id);
}

function getDateValue(properties, name) {
  const start = properties?.[name]?.date?.start || "";
  return splitNotionDate(start);
}

function splitNotionDate(value) {
  if (!value) {
    return {
      raw: "",
      date: "",
      time: "",
    };
  }

  if (!value.includes("T")) {
    return {
      raw: value,
      date: value,
      time: "",
    };
  }

  const d = new Date(value);

  if (Number.isNaN(d.getTime())) {
    return {
      raw: value,
      date: value.slice(0, 10),
      time: value.slice(11, 16),
    };
  }

  const date = value.slice(0, 10);
  const time = value.slice(11, 16);

  return {
    raw: value,
    date,
    time,
  };
}

function getTitlePropertyName(database) {
  const entries = Object.entries(database.properties || {});
  const found = entries.find(([, prop]) => prop.type === "title");
  return found ? found[0] : null;
}

function normalizeRelationIds(value) {
  if (!value) return [];

  if (Array.isArray(value)) {
    return value.filter(Boolean).map(id => ({ id }));
  }

  return [{ id: value }];
}

/* =========================
   필터 / 정렬
========================= */

function dateRangeFilter(propertyName, from, to) {
  const filters = [];

  if (from) {
    filters.push({
      property: propertyName,
      date: {
        on_or_after: from,
      },
    });
  }

  if (to) {
    filters.push({
      property: propertyName,
      date: {
        on_or_before: to,
      },
    });
  }

  if (!filters.length) return null;
  if (filters.length === 1) return filters[0];

  return {
    and: filters,
  };
}

function combineFilters(filters) {
  const valid = filters.filter(Boolean);

  if (!valid.length) return undefined;
  if (valid.length === 1) return valid[0];

  return {
    and: valid,
  };
}

/* =========================
   Calendar 통합 조회
========================= */

async function getCalendar(request, env) {
  const url = new URL(request.url);
  const from = url.searchParams.get("from");
  const to = url.searchParams.get("to");
  const includeCanceled = url.searchParams.get("includeCanceled") === "true";

  const [schedulesResult, todosResult] = await Promise.all([
    getSchedulesData(env, { from, to, includeCanceled }),
    getTodosData(env, { from, to }),
  ]);

  return json(request, env, {
    schedules: schedulesResult,
    todos: todosResult,
  });
}

/* =========================
   할 일 DB
   속성:
   - 제목: 할 일 목록
   - 날짜: 등록일
   - 완료: 체크리스트
   - 메모: 메모
   - 관계형: 관련 프로젝트
========================= */

async function getTodos(request, env) {
  const url = new URL(request.url);
  const from = url.searchParams.get("from");
  const to = url.searchParams.get("to");

  const todos = await getTodosData(env, { from, to });

  return json(request, env, {
    todos,
  });
}

async function getTodosData(env, { from, to } = {}) {
  const filter = dateRangeFilter("등록일", from, to);

  const body = {
    sorts: [
      {
        property: "등록일",
        direction: "ascending",
      },
    ],
  };

  if (filter) {
    body.filter = filter;
  }

  const result = await notionQueryDatabase(env, env.NOTION_TODO_DB_ID, body);

  return result.results.map(page => {
    const props = page.properties || {};
    const dateInfo = getDateValue(props, "등록일");

    return {
      id: page.id,
      title: getTitleFromProperties(props) || "제목 없음",
      date: dateInfo.date,
      time: dateInfo.time,
      done: getCheckbox(props, "체크리스트"),
      memo: getRichText(props, "메모"),
      projectIds: getRelationIds(props, "관련 프로젝트"),
      color: "task",
      type: "todo",
      raw: page,
    };
  });
}

async function createTodo(request, env) {
  const body = await request.json();

  if (!body.title) {
    return json(request, env, { error: "title is required" }, 400);
  }

  const properties = {
    "할 일 목록": {
      title: [
        {
          text: {
            content: body.title,
          },
        },
      ],
    },
    "체크리스트": {
      checkbox: Boolean(body.done),
    },
  };

  if (body.date) {
    properties["등록일"] = {
      date: {
        start: body.date,
      },
    };
  }

  if (body.memo) {
    properties["메모"] = {
      rich_text: [
        {
          text: {
            content: body.memo,
          },
        },
      ],
    };
  }

  const projectRelation = normalizeRelationIds(
    body.projectPageIds || body.projectPageId
  );

  if (projectRelation.length) {
    properties["관련 프로젝트"] = {
      relation: projectRelation,
    };
  }

  const data = await notionCreatePage(env, env.NOTION_TODO_DB_ID, properties);

  return json(request, env, {
    ok: true,
    page: data,
  });
}

/* =========================
   일정 DB
   속성:
   - 제목: 자동 탐색
   - 날짜: 날짜
   - 카테고리: 카테고리
   - 프로젝트: 프로젝트
   - 개인 메모: 개인 메모
   - 취소 일정: 카테고리 값이 "취소"면 기본 숨김
========================= */

async function getSchedules(request, env) {
  const url = new URL(request.url);
  const from = url.searchParams.get("from");
  const to = url.searchParams.get("to");
  const includeCanceled = url.searchParams.get("includeCanceled") === "true";

  const schedules = await getSchedulesData(env, {
    from,
    to,
    includeCanceled,
  });

  return json(request, env, {
    schedules,
  });
}

async function getSchedulesData(env, { from, to, includeCanceled } = {}) {
  const cancelCategory = env.SCHEDULE_CANCEL_CATEGORY || "취소";

  const filters = [
    dateRangeFilter("날짜", from, to),
  ];

  if (!includeCanceled) {
    filters.push({
      property: "카테고리",
      select: {
        does_not_equal: cancelCategory,
      },
    });
  }

  const filter = combineFilters(filters);

  const body = {
    sorts: [
      {
        property: "날짜",
        direction: "ascending",
      },
    ],
  };

  if (filter) {
    body.filter = filter;
  }

  const result = await notionQueryDatabase(env, env.NOTION_SCHEDULE_DB_ID, body);

  return result.results.map(page => {
    const props = page.properties || {};
    const dateInfo = getDateValue(props, "날짜");
    const category = getSelectName(props, "카테고리");
    const memoTags = getMultiSelectNames(props, "개인 메모");

    return {
      id: page.id,
      title: getTitleFromProperties(props) || "제목 없음",
      date: dateInfo.date,
      time: dateInfo.time,
      category,
      subject: category || "일정",
      canceled: category === cancelCategory,
      memoTags,
      projectIds: getRelationIds(props, "프로젝트"),
      color: scheduleColor(category),
      type: "schedule",
      raw: page,
    };
  });
}

async function createSchedule(request, env) {
  const body = await request.json();

  if (!body.title) {
    return json(request, env, { error: "title is required" }, 400);
  }

  if (!body.date) {
    return json(request, env, { error: "date is required" }, 400);
  }

  const database = await notionRetrieveDatabase(env, env.NOTION_SCHEDULE_DB_ID);
  const titlePropName =
    env.NOTION_SCHEDULE_TITLE_PROP ||
    getTitlePropertyName(database);

  if (!titlePropName) {
    return json(request, env, {
      error: "Schedule title property not found",
    }, 500);
  }

  const properties = {
    [titlePropName]: {
      title: [
        {
          text: {
            content: body.title,
          },
        },
      ],
    },
    "날짜": {
      date: {
        start: body.time ? `${body.date}T${body.time}:00+09:00` : body.date,
      },
    },
  };

  if (body.category) {
    properties["카테고리"] = {
      select: {
        name: body.category,
      },
    };
  }

  const projectRelation = normalizeRelationIds(
    body.projectPageIds || body.projectPageId
  );

  if (projectRelation.length) {
    properties["프로젝트"] = {
      relation: projectRelation,
    };
  }

  if (Array.isArray(body.memoTags) && body.memoTags.length) {
    properties["개인 메모"] = {
      multi_select: body.memoTags.map(name => ({ name })),
    };
  }

  const data = await notionCreatePage(env, env.NOTION_SCHEDULE_DB_ID, properties);

  return json(request, env, {
    ok: true,
    page: data,
  });
}

function scheduleColor(category) {
  if (category === "취소") return "canceled";
  if (category === "약속") return "meeting";
  if (category === "개인일정") return "personal";
  if (category === "개인") return "personal";
  if (category === "업무일정") return "work";
  if (category === "업무") return "work";
  return "work";
}
